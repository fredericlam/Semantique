{
  "name": "semantique",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"wrangler dev --port 8787\" \"vite\"",
    "build": "vite build",
    "preview": "vite build && wrangler dev --port 8787",
    "seed": "node scripts/seed.mjs",
    "seed:remote": "node scripts/seed.mjs --remote",
    "deploy": "vite build && wrangler deploy",
    "icons": "node scripts/icons.mjs",
    "check": "tsc --noEmit -p . && tsc --noEmit -p server"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "hono": "^4.13.19",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "svelte": "^5.58.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.165.0"
  }
}
