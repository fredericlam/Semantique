{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node", "svelte"]
  },
  "include": ["src/**/*", "server/**/*", "vite.config.ts"]
}
